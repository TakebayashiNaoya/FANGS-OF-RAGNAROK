<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Preview|x64"><Configuration>Preview</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="DebugXbox|x64"><Configuration>DebugXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="PreviewXbox|x64"><Configuration>PreviewXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseXbox|x64"><Configuration>ReleaseXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{CB5862F9-812A-BC61-ACE7-D28939BAB2F6}</ProjectGuid>
    <RootNamespace>Editor</RootNamespace>
    <ProjectName>Editor</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="FangModule">
    <FangModuleDependencies>Core;RHI;Runtime</FangModuleDependencies>
  </PropertyGroup>

  <Import Project="$(FangRoot)Build\Module.props" />
  <Import Project="$(FangRoot)Build\ThirdParty.imgui.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- FANG_FILES_BEGIN 自動生成。Tools\GenerateProjectFiles.py が書き換える。手で編集しない -->
  <ItemGroup>
    <ClInclude Include="Editor.h" />
    <ClInclude Include="EditorLog.h" />
    <ClInclude Include="EditorUI.h" />
    <ClInclude Include="ImGuiPlatformInput.h" />
    <ClInclude Include="Pch.h" />
    <ClInclude Include="Panels\JobSystemPanel.h" />
    <ClInclude Include="Panels\RenderStatisticsPanel.h" />
    <ClInclude Include="Xbox\GamepadReader.h" Condition="'$(FangIsXbox)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Editor.cpp" />
    <ClCompile Include="EditorUI.cpp" />
    <ClCompile Include="Pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Panels\JobSystemPanel.cpp" />
    <ClCompile Include="Panels\RenderStatisticsPanel.cpp" />
    <ClCompile Include="Windows\ImGuiPlatformInput.cpp" Condition="'$(FangIsXbox)' != 'true'" />
    <ClCompile Include="Xbox\GamepadReader.cpp" Condition="'$(FangIsXbox)' == 'true'" />
    <ClCompile Include="Xbox\ImGuiPlatformInput.cpp" Condition="'$(FangIsXbox)' == 'true'" />
  </ItemGroup>
  <!-- FANG_FILES_END -->

  <!-- C++/WinRT を使う TU だけ例外を有効にする（例外は全構成オフの方針で、WinRT の境界だけ許す）。生成ツールの対象外なので手で書く。
       PCH は例外オフでコンパイルされているので使わない（Pch.h は普通の include として読まれる）。
       PreprocessorDefinitions は %() を継がずに全部書く。継ぐと Common.props の _HAS_EXCEPTIONS=0 と
       二重定義になって C4005 で止まる。継がない代わりに ThirdParty.imgui.props の定義が落ちるので、
       この TU では imgui のヘッダを一切 include しない -->
  <ItemGroup Condition="'$(FangIsXbox)' == 'true'">
    <ClCompile Update="Xbox\GamepadReader.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>$(FangFeatureDefines);$(FangPlatformDefines);_HAS_EXCEPTIONS=1</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>

  <!-- シェーダーはビルド時に FXC でヘッダ化して埋め込む（UWP に実行時コンパイルが無いため）。生成ツールの対象外なので手で書く -->
  <ItemGroup>
    <FXCompile Include="Shaders\ImGuiVS.hlsl">
      <ShaderType>Vertex</ShaderType>
      <EntryPointName>VertexMain</EntryPointName>
    </FXCompile>
    <FXCompile Include="Shaders\ImGuiPS.hlsl">
      <ShaderType>Pixel</ShaderType>
      <EntryPointName>PixelMain</EntryPointName>
    </FXCompile>
    <None Include="Shaders\ImGui.hlsli" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <FXCompile>
      <ShaderModel>5.1</ShaderModel>
      <HeaderFileOutput>$(IntDir)Shaders\%(Filename).h</HeaderFileOutput>
      <VariableName>g_%(Filename)</VariableName>
      <ObjectFileOutput></ObjectFileOutput>
    </FXCompile>
    <ClCompile>
      <AdditionalIncludeDirectories>$(IntDir)Shaders;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
