<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Preview|x64"><Configuration>Preview</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="DebugXbox|x64"><Configuration>DebugXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="PreviewXbox|x64"><Configuration>PreviewXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseXbox|x64"><Configuration>ReleaseXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{F1BE5581-89F2-DF75-36ED-BDFB045C5B5E}</ProjectGuid>
    <RootNamespace>Input</RootNamespace>
    <ProjectName>Input</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="FangModule">
    <FangModuleDependencies>Core</FangModuleDependencies>
  </PropertyGroup>

  <Import Project="$(FangRoot)Build\Module.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- FANG_FILES_BEGIN 自動生成。Tools\GenerateProjectFiles.py が書き換える。手で編集しない -->
  <ItemGroup>
    <ClInclude Include="Gamepad.h" />
    <ClInclude Include="GamepadDestination.h" />
    <ClInclude Include="Input.h" />
    <ClInclude Include="InputLog.h" />
    <ClInclude Include="Pch.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Gamepad.cpp" />
    <ClCompile Include="Input.cpp" />
    <ClCompile Include="Pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Windows\GamepadReader.cpp" Condition="'$(FangIsXbox)' != 'true'" />
    <ClCompile Include="Xbox\GamepadReader.cpp" Condition="'$(FangIsXbox)' == 'true'" />
  </ItemGroup>
  <!-- FANG_FILES_END -->

  <!-- C++/WinRT を使う TU だけ例外を有効にする（例外は全構成オフの方針で、WinRT の境界だけ許す）。生成ツールの対象外なので手で書く。
       PCH は例外オフでコンパイルされているので使わない（Pch.h は普通の include として読まれる）-->
  <ItemGroup Condition="'$(FangIsXbox)' == 'true'">
    <ClCompile Update="Xbox\GamepadReader.cpp">
      <ExceptionHandling>Sync</ExceptionHandling>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PreprocessorDefinitions>$(FangFeatureDefines);$(FangPlatformDefines);_HAS_EXCEPTIONS=1</PreprocessorDefinitions>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
