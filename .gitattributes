# 改行コードは Windows 専用プロジェクトなので CRLF に統一（.editorconfig と一致）
* text=auto eol=crlf
*.sh text eol=lf
.gitattributes text eol=lf

# Visual Studio が扱うファイル
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxitems text eol=crlf
*.vcxproj.filters text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# サードパーティは上流のまま置く（改行を変えると上流との差分が取れなくなる）
ThirdParty/** -text

# バイナリ（差分を取らない）
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.dds binary
*.hdr binary
*.exr binary
*.wav binary
*.ogg binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.fbx binary
*.efk binary
*.efkefc binary
*.cso binary
*.lib binary
*.dll binary
*.exe binary
*.pdb binary

# 大きいアセットは Git LFS（git lfs install 後に有効。Phase 1 で運用開始するときにコメントを外す）
