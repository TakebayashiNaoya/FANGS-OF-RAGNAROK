id="c519" value="DeferredReleaseQueue" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1180" y="808" width="340" height="94" as="geometry"/></mxCell><mxCell id="c520" value="- m_entries : vector&amp;lt;pair&amp;lt;ComPtr&amp;lt;ID3D12Resource&amp;gt;, uint64_t&amp;gt;&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c519"><mxGeometry y="26" width="340" height="20" as="geometry"/></mxCell><mxCell id="c521" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="c519"><mxGeometry y="46" width="340" height="8" as="geometry"/></mxCell><mxCell id="c522" value="+ Release(res, fenceValue) : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c519"><mxGeometry y="54" width="340" height="20" as="geometry"/></mxCell><mxCell id="c523" value="+ Flush(completedFence) : void  // Main" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c519"><mxGeometry y="74" width="340" height="20" as="geometry"/></mxCell><mxCell id="c524" value="解放は遅延" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c511" target="c519"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c525" value="読み込みの流れ (例: Texture)&lt;br&gt;① IOThread : ファイル → バイト列&lt;br&gt;② Job : Decode (DDS 解析など)&lt;br&gt;③ Job : CreateGpu → ID3D12Resource 生成 + DescriptorAllocator で SRV&lt;br&gt;④ GpuUploader : Copy Queue で転送 → Fence&lt;br&gt;⑤ Main : ResourceManager::Update で Fence 完了を確認 → Ready&lt;br&gt;&lt;br&gt;依存 (Model → Texture) が全部 Ready で親も Ready。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="340" height="190" as="geometry"/></mxCell><mxCell id="c526" value="ロードと解放の方針&lt;br&gt;・レベルのリソースは LevelLoadHandle の完了に含める → Start 時点で必ず Ready&lt;br&gt;・実行中に CreateObject する物は Level JSON の &quot;preload&quot; で先読み&lt;br&gt;・間に合わない場合は IsReady() が false の間は描かない (エラーにしない)&lt;br&gt;・Level Unload 後に UnloadUnused() → 参照がキャッシュだけの物を解放&lt;br&gt;・GPU リソースは DeferredReleaseQueue で Fence 完了後に解放&lt;br&gt;・CPU のメモリはアロケーターから取る (HeapAllocator / StackAllocator)。GPU リソースは CreateCommittedResource のまま" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="420" y="780" width="720" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8. 入力"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i1" value="入力（ゲームはアクションで読む / ボタンは位置の名前 / 割り当ては画面で変えて差分を保存）" style="text;h