height="8" as="geometry"/></mxCell><mxCell id="c923" value="Play / PlayMusic" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c920"><mxGeometry y="54" width="144" height="20" as="geometry"/></mxCell><mxCell id="c924" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;strokeColor=#1F4E79;fontColor=#1F4E79;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c920"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c925" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c924"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c926" value="EffectSystem" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1866" y="274" width="144" height="74" as="geometry"/></mxCell><mxCell id="c927" value="→ 13. エフェクト" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c926"><mxGeometry y="26" width="144" height="20" as="geometry"/></mxCell><mxCell id="c928" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="c926"><mxGeometry y="46" width="144" height="8" as="geometry"/></mxCell><mxCell id="c929" value="Play / Attach" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c926"><mxGeometry y="54" width="144" height="20" as="geometry"/></mxCell><mxCell id="c930" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;strokeColor=#1F4E79;fontColor=#1F4E79;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c926"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c931" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c930"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c932" value="CueSystem" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="2019" y="274" width="144" height="74" as="geometry"/></mxCell><mxCell id="c933" value="→ 13. 演出の束" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c932"><mxGeometry y="26" width="144" height="20" as="geometry"/></mxCell><mxCell id="c934" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;" vertex="1" parent="c932"><mxGeometry y="46" width="144" height="8" as="geometry"/></mxCell><mxCell id="c935" value="Play / Flush" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c932"><mxGeometry y="54" width="144" height="20" as="geometry"/></mxCell><mxCell id="c936" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;strokeColor=#1F4E79;fontColor=#1F4E79;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c3" target="c932"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c937" value="1" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="c936"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="6" as="offset"/></mxGeometry></mxCell><mxCell id="c70" value="1 フレームの流れ (Application::Run)  ※ dt は最大 1/30 秒に制限&lt;br&gt;1. InputManager::Update  (スナップショット確定)&lt;br&gt;2. GameStateMachine::Update  (遷移は予約制)&lt;br&gt;3. ResourceManager::Update / LevelManager::Update&lt;br&gt;    (同期点: ロード完了の受け取り・完成品を登録)&lt;br&gt;4. StartPendingObjects  (Start)&lt;br&gt;4&#x27;. AnimationSystem::Advance  (時間・イベント・ルートモーション)  ← ParallelFor&lt;br&gt;5. UpdateGroup(PreUpdate)&lt;br&gt;6. UpdateGroup(Gameplay)&lt;br&gt;6&#x27;. UpdateGroup(ParallelGameplay)  ← ParallelFor&lt;br&gt;7. PhysicsWorld::StepFixed  (60Hz 固定 / 最大 2 回。この間クエリ禁止)&lt;br&gt;8. UpdateGroup(PostPhysics) + SyncActiveBodies (補間して反映)&lt;br&gt;8&#x27;. AnimationSystem::Evaluate  (姿勢・IK・スキン行列)  ← ParallelFor&lt;br&gt;8&#x27;&#x27;. UpdateGroup(PostAnimation)  (攻撃判定・GoLimp)&lt;br&gt;8&#x27;&#x27;&#x27;. CueSystem::Flush  (音・エフェクト・ヒットストップなどを配る)&lt;br&gt;9. UpdateGroup(Camera) → CameraManager::Update&lt;br&gt;10. UpdateGroup(Late)&lt;br&gt;10&#x27;. AudioSystem::Update  (XAudio2 はここだけ)&lt;br&gt;11. UIContext::Update → CollectRenderItems&lt;br&gt;12. DestroyRequestedObjects  (OnDestroy → 破棄)&lt;br&gt;    + GPU 遅延解放 (Fence 完了分)&lt;br&gt;13. Renderer::BuildFrame (シーン入れ替え → 共有処理 → ビューごとにカリング) → RenderThread" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="424" width="420" height="350" as="geometry"/></mxCell><mxCell id="c71" value="ターゲット: Xbox One S (UWP Dev Mode「Game」分類)&lt;br&gt;CPU 4 コア占有 + 2 コア共有 / RAM 5GB / D3D12 FL12_0&lt;br&gt;&lt;br&gt;スレッド構成 (コア固定)&lt;br&gt;Core0 : Main    Core1 : Render&lt;br&gt;Core2-3 : Worker (高優先)&lt;br&gt;Core4-5 : Worker (低優先) + IO スレッド  ← 共有コア&lt;br&gt;&lt;br&gt;専用スレッドは Main / Render / IO のみ。&lt;br&gt;それ以外の並列処理はすべて JobSystem のジョブ。" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="490" y="424" width="440" height="190" as="geometry"/></mxCell><mxCell id="c72" value="凡例" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#FAFAFA;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="424" width="390" height="260" as="geometry"/></mxCell><mxCell id="c73" value="A" style="rounded=0;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="464" width="30" height="22" as="geometry"/></mxCell><mxCell id="c74" value="B" style="rounded=0;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="464" width="30" height="22" as="geometry"/></mxCell><mxCell id="c75" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c73" target="c74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="A が B を所有する（コンポジション）" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="460" width="200" height="30" as="geometry"/></mxCell><mxCell id="c77" value="A" style="rounded=0;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="30" height="22" as="geometry"/></mxCell><mxCell id="c78" value="B" style="rounded=0;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1090" y="500" width="30" height="22" as="geometry"/></mxCell><mxCell id="c79" value="" style="startArrow=diamondThin;startFill=0;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c77" target="c78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="A が B を参照（所有しない）" style="text;html=1;fillColor=none;strokeColor=none;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="496" width="200" height="30" as="geometry"/></mxCell><mxCell id="c81" value="A" style="rounded=0;html=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="536" width="30" height="22" as="geometry"/></mxCell><mxCell id="c82" value="B" style="rounded=0;html=1;fontSize=1