lue="モデルから当たり用メッシュを作る" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;fontColor=#666666;" vertex="1" parent="c866"><mxGeometry y="54" width="340" height="20" as="geometry"/></mxCell><mxCell id="c870" value="ロード時にジョブで生成" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;fontColor=#666666;" vertex="1" parent="c866"><mxGeometry y="74" width="340" height="20" as="geometry"/></mxCell><mxCell id="c871" value="" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c847" target="c819"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c872" value="カプセル" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c853" target="c826"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c873" value="" style="endArrow=open;endSize=12;dashed=1;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#B85450;fontColor=#B85450;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c859" target="c831"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c874" value="スレッドと更新順のルール&lt;br&gt;・AddBody / RemoveBody は Main (Start / OnDestroy) だけ&lt;br&gt;・Gameplay / ParallelGameplay : CharacterMover はクエリで動くだけ。&lt;br&gt;  世界は書き換えない (押す力・インパルスは予約)&lt;br&gt;・StepFixed : Jolt が JobSystem で並列計算。この間クエリ禁止&lt;br&gt;・PostPhysics : SyncActiveBodies (動いた本体だけ・alpha で補間)、ラグドール → 骨&lt;br&gt;・PostAnimation : 攻撃の掃引、GoLimp (AddBody) (→ 12)&lt;br&gt;・Camera : 遮蔽回避の SweepSphere&lt;br&gt;・止まった本体は Jolt が自動スリープ → コストほぼ 0" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="778" width="340" height="250" as="geometry"/></mxCell><mxCell id="c875" value="剛体の力学 (Dynamic)&lt;br&gt;・ゲームは形・重さを決めて登録し、必要なら力を加えるだけ&lt;br&gt;・位置は物理エンジンが決め、エンジンが自動で描画へ反映&lt;br&gt;・ラグドール : 死亡時に本体を作って Dynamic へ&lt;br&gt;  アニメ最後の姿勢から本体を作る (→ 12)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="1048" width="340" height="150" as="geometry"/></mxCell><mxCell id="c876" value="Barrel (例)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#EFFFEA;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="340" height="94" as="geometry"/></mxCell><mxCell id="c877" value="- m_model : ModelRender" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="c876"><mxGeometry y="26" width="340" height="20" as="geometry"/></mxCell><mxCell id="c878" value="- m_body : PhysicsBody  // Dynamic" style="text;strokeColor=none;fillColor=none;align=left;vertical