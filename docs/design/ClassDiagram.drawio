xt;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="b73"><mxGeometry y="26" width="440" height="20" as="geometry"/></mxCell><mxCell id="b75" value="PostEffectPass : DamageVignette / LowHealth ..." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="b73"><mxGeometry y="46" width="440" height="20" as="geometry"/></mxCell><mxCell id="b76" value="EffectPass" style="endArrow=open;endSize=12;dashed=1;strokeColor=#B85450;fontColor=#B85450;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b68" target="b73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b77" value="PostEffectPass" style="endArrow=open;endSize=12;dashed=1;strokeColor=#B85450;fontColor=#B85450;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="b56" target="b73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b78" value="cues/wolf.cues.json (例)&lt;br&gt;&quot;Wolf_Bite_Hit&quot;: { &quot;sound&quot;: { &quot;sound&quot;: &quot;SE_Bite_Hit&quot; },&lt;br&gt;  &quot;effect&quot;: { &quot;effect&quot;: &quot;FX_Blood_Spray&quot;, &quot;at&quot;: &quot;position&quot; },&lt;br&gt;  &quot;hitStop&quot;: { &quot;instigator&quot;: 0.06, &quot;target&quot;: 0.08 },&lt;br&gt;  &quot;cameraShake&quot;: &quot;Medium&quot;, &quot;vibration&quot;: { &quot;low&quot;: 0.4, &quot;high&quot;: 0.8, &quot;seconds&quot;: 0.15 },&lt;br&gt;  &quot;screen&quot;: { &quot;effect&quot;: &quot;DamageVignette&quot;, &quot;intensity&quot;: 0.6 } }&lt;br&gt;&quot;Wolf_Footstep&quot;: { &quot;sound&quot;: { &quot;sound&quot;: &quot;SE_Footstep_Wolf&quot;, &quot;surface&quot;: &quot;ground&quot; },&lt;br&gt;  &quot;effect&quot;: { &quot;effect&quot;: &quot;FX_Dust_Small&quot;, &quot;at&quot;: &quot;bone&quot; } }&lt;br&gt;&quot;Wolf_Breath&quot;: { &quot;effect&quot;: { &quot;effect&quot;: &quot;FX_Breath&quot;, &quot;at&quot;: &quot;bone&quot;, &quot;follow&quot;: true } }" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="820" height="160" as="geometry"/></mxCell><mxCell id="b79" value="スレッドの決まり&lt;br&gt;・Cue / 音 / エフェクトの要求は、どのスレッドからでもキューに積むだけ&lt;br&gt;・XAudio2 に触るのは Main の AudioSystem::Update だけ&lt;br&gt;・エフェクトの再生に触るのは RenderThread だけ。Main は RenderFrame にコマンドを書く&lt;br&gt;・エフェクトの中身は記録 (.fxrec.json + .bin)。記録ツールは C:\Git\EffectRecorder" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="900" y="960" width="900" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>