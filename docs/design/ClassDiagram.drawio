側へコピー&lt;br&gt;  (しないと片側だけ古い値が残る)&lt;br&gt;&lt;br&gt;GPU 側は別。実行中のフレーム数分の&lt;br&gt;アップロードバッファを持つ" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1240" y="906" width="320" height="190" as="geometry"/></mxCell><mxCell id="c323" value="将来の段階 (ゲーム側の使い方は変わらない)&lt;br&gt;1. CPU ParallelFor カリング + 共有 (今回)&lt;br&gt;2. 同じメッシュ・マテリアルをインスタンシング描画&lt;br&gt;3. GPU カリング + ExecuteIndirect" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="880" y="1056" width="320" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5. UI"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c324" value="UI（IGameObject とは別系統 / レイアウトは JSON）" style="text;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="900" height="30" as="geometry"/></mxCell><mxCell id="c325" value="Engine" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1420" height="860" as="geometry"/></mxCell><mxCell id="c326" value="Game" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F7FFF5;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="1420" height="330" as="geometry"/></mxCell><mxCell id="c327" value="UIContext" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;h