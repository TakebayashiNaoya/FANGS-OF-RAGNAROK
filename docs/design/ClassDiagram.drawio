n;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c881" target="c853"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c895" value="" style="startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#1F4E79;fontColor=#1F4E79;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c881" target="c859"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="726.0" y="1250"/><mxPoint x="970.0" y="1250"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="12. アニメーション"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="アニメーション（エンジンは再生機まで / Advance と Evaluate の 2 段 / 時間窓は最新の再生だけ）" style="text;html=1;fillColor=none;strokeColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1600" height="30" as="geometry"/></mxCell><mxCell id="a2" value="1 フレームの中の順番（矢印は時間の流れ。番号は 1 ページ目のフレームの流れ）" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#FAFAFA;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1650" height="160" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;4&#x27;. Advance  (全員・毎フレーム)&lt;/b&gt;&lt;br&gt;・時間とフェードを進める&lt;br&gt;・イベント / ルートモーションを確定" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="300" height="95" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;5〜6&#x27;. Character の Update  (Game)&lt;/b&gt;&lt;br&gt;・イベントと時間窓を見て Play()&lt;br&gt;・ルートモーション → CharacterMover" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFFFEA;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="370" y="85" width="300" height="95" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;8&#x27;. Evaluate  (LOD で間引く)&lt;/b&gt;&lt;br&gt;・サンプリング → ブレンド → IK → 行列&lt;br&gt;・Hit 窓の間は Full" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="700" y="85" width="300" height="95" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;8&#x27;&#x27;. PostAnimation  (Main・新設)&lt;/b&gt;&lt;br&gt;・WeaponHitDetector の掃引&lt;br&gt;・RagdollBody::GoLimp" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFFFEA;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1030" y="85" width="300" height="95" as="geometry"/></mxCell><mxCell id="a7" value="&lt;b&gt;13. 描画&lt;/b&gt;&lt;br&gt;・スキン行列 (UpdateSkinPalette)&lt;br&gt;・GPU スキニングは 1 回" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1360" y="85" width="300" height="95" as="geometry"/></mxCell><mxCell id="a8" value="" style="endArrow=block;endFill=1;endSize=10;html=1;strokeWidth=2.5;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" value="" style="endArrow=block;endFill=1;endSize=10;html=1;strokeWidth=2.5;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a10" value="" style="endArrow=block;endFill=1;endSize=10;html=1;strokeWidth=2.5;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a11" value="" style="endArrow=block;endFill=1;endSize=10;html=1;strokeWidth=2.5;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a12" value="Game（使う側）" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F7FFF5;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="480" height="640" as="geometry"/></mxCell><mxCell id="a13" value="Engine" style="rounded=0;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;fillColor=#F5F9FF;strokeColor=#BBBBBB;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="1150" height="640" as="geometry"/></mxCell><mxCell id="a14" value="Character  (→ 9)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="440" height="86" as="geometry"/></mxCell><mxCell id="a15" value="m_animator : Animator" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="a14"><mxGeometry y="26" width="440" height="20" as="geometry"/></mxCell><mxCell id="a16" value="Update : イベント・時間窓を見て Play()" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="a14"><mxGeometry y="46" width="440" height="20" as="geometry"/></mxCell><mxCell id="a17" value="ルートモーション → m_mover.Move" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="a14"><mxGeometry y="66" width="440" height="20" as="geometry"/></mxCell><mxCell id="a18" value="WeaponHitDetector  (→ 11)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#F2F2F2;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="440" height="66" as="geometry"/></mxCell><mxCell id="a19" value="PostAnimation : Hit 窓の間だけ" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="a18"><mxGeometry y="26" width="440" height="20" as="geometry"/></mxCell><mxCell id="a20" value="前フレームの骨の位置 → 今の位置を掃引" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontFamily=Consolas;fontSize=11;" vertex="1" parent="a18"><mxGeometry y="46" width="440" height="20" as="geometry"/></mxCell><mxCell id="a21" value="Wolfr_Attack_Bite_Forward.anim.json (例)&lt;br&gt;{ &quot;loop&quot;: false, &quot;rootMotion&quot;: true, &quot;events&quot;: [&lt;br&gt;  { &quot;name&quot;: &quot;Hit&quot;, &quot;start&quot;: 0.40, &quot;end&quot;: 0.55,&lt;br&gt;    &quot;params&quot;: { &quot;bone&quot;: &quot;Jaw&quot; } },&lt;br&gt;  { &quot;name&quot;: &quot;Cancel&quot;, &quot;start&quot;: 0.70, &quot;end&quot;: 1.00 },&lt;br&gt;  { &quot;name&quot;: &quot;Footstep&quot;, &quot;time&quot;: 0.62,&lt;br&gt;    &quot;params&quot;: { &quot;leg&quot;: &quot;FL&quot; } } ] }&lt;br&gt;&lt;br&gt;time = 瞬間、start / end = 時間窓 (2 フレーム以上)&lt;br&gt;名前の意味はゲームが決める" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="440" height="190" as="geometry"/></mxCell><mxCell id="a22" value="狼の素材 (SK_Wolf_Realistic.fbx)&lt;br&gt;・ルートモーションは Root 骨。30fps / Z-up / cm&lt;br&gt;・移動は速度の 1D。横歩きがないので、&lt;br&gt;   ロックオン中も体は進行方向、頭を注視 IK で敵へ" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="440" height="95" as="geometry"/></mxCell><mxCell id="a23" value="AnimationSystem  (Application が所有)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="540" y="280" width="500" height="86" as="geometry"/></mxCell><mxCell id="a24" value="+ Advance(dt)  // 4&#x27; ParallelFor" style="text;strokeColor=none