<?xml version="1.0" encoding="utf-8"?>
<!--
  Dependencies.props
  $(FangModuleDependencies)（例: Core;RHI）から、参照先モジュールの
  プロジェクト参照とインクルードパスの両方を作る。
  依存を .vcxproj 側に 1 行で書けるようにするため。
  ここで足したパス以外は通らないので、参照していないモジュールの include はコンパイルエラーになる。
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- 項目一覧式は ItemDefinitionGroup に書けないので、文字列置換でパスを組み立てる -->
    <FangDependencyIncludes Condition="'$(FangModuleDependencies)' != ''">$(FangRoot)Engine\$(FangModuleDependencies.Replace(';','\Public;$(FangRoot)Engine\'))\Public</FangDependencyIncludes>
  </PropertyGroup>

  <ItemGroup>
    <FangDependency Include="$(FangModuleDependencies)" />
    <ProjectReference Include="@(FangDependency->'$(FangRoot)Engine\%(Identity)\%(Identity).vcxproj')" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- プロパティ関数の戻り値は ; がエスケープされるので、ここで戻さないと /I 1 個にまとまってしまう -->
      <AdditionalIncludeDirectories>$([MSBuild]::Unescape($(FangDependencyIncludes)));%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>
