<?xml version="1.0" encoding="utf-8"?>
<!--
  ThirdParty.doctest.props
  doctest（単一ヘッダ、MIT）。上流のファイルをそのまま置く。
  例外を切っているので REQUIRE 系は使えない。CHECK 系で書く。
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(FangRoot)ThirdParty\doctest;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- DOCTEST_CONFIG_USE_STD_HEADERS: doctest は既定で std::ostream などを自分で前方宣言する。
           その後に <string_view> のような標準ヘッダが来ると、実体を知らないまま operator<< を定義しに行って壊れる。
           本物の宣言を読ませて衝突をなくす -->
      <PreprocessorDefinitions>DOCTEST_CONFIG_NO_EXCEPTIONS;DOCTEST_CONFIG_USE_STD_HEADERS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- doctest が std::tuple を前方宣言するため（C5285）。/W4 /WX は緩めない -->
      <DisableSpecificWarnings>5285;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>
