<?xml version="1.0" encoding="utf-8"?>
<!--
  Module.props
  エンジンの 1 モジュール = 1 static lib の共通設定。
  各 .vcxproj は名前と依存だけを書き、これを Import する。
  Microsoft.Cpp.props より前に Import すること（ConfigurationType を決めるため）。
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>

  <Import Project="$(FangRoot)Build\Dependencies.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- Engine\ はモジュール名から始まる include 用。モジュール直下はサブフォルダの cpp が "Pch.h" を見つけるため -->
      <AdditionalIncludeDirectories>$(FangRoot)Engine;$(MSBuildProjectDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>Pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)$(MSBuildProjectName).pch</PrecompiledHeaderOutputFile>
    </ClCompile>
  </ItemDefinitionGroup>

</Project>
