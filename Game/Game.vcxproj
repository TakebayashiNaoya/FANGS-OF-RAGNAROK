<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Preview|x64"><Configuration>Preview</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="DebugXbox|x64"><Configuration>DebugXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="PreviewXbox|x64"><Configuration>PreviewXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseXbox|x64"><Configuration>ReleaseXbox</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{D197C55F-EC0C-5D46-6A8E-58383A9CBFEC}</ProjectGuid>
    <RootNamespace>Game</RootNamespace>
    <ProjectName>Game</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="FangModule">
    <!-- ソースは Game.Shared.vcxitems 側で拾う -->
    <FangModuleDependencies>Core;RHI;Runtime;Scene;Renderer;Collision;Resource;Animation;Input;AI</FangModuleDependencies>
    <!-- Release では Editor と imgui をリンクしない（02 3）-->
    <FangModuleDependencies Condition="'$(FangConfigurationBase)' != 'Release'">$(FangModuleDependencies);Editor</FangModuleDependencies>
  </PropertyGroup>

  <Import Project="$(FangRoot)Build\Program.props" />
  <!-- Editor/EditorUI.h が imgui.h を include するので、Editor をリンクする構成では include パスが要る -->
  <Import Project="$(FangRoot)Build\ThirdParty.imgui.props" Condition="'$(FangConfigurationBase)' != 'Release'" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <!-- FANG_FILES_BEGIN 自動生成。Tools\GenerateProjectFiles.py が書き換える。手で編集しない -->
  <ItemGroup>
    <ClInclude Include="Source\CameraFollowParameter.h" />
    <ClInclude Include="Source\CollisionAttribute.h" />
    <ClInclude Include="Source\Enemy.h" />
    <ClInclude Include="Source\EnemyController.h" />
    <ClInclude Include="Source\EnemyManager.h" />
    <ClInclude Include="Source\GameLog.h" />
    <ClInclude Include="Source\GameMain.h" />
    <ClInclude Include="Source\MeleeDamage.h" />
    <ClInclude Include="Source\Stage.h" />
    <ClInclude Include="Source\Wolf.h" />
    <ClInclude Include="Source\WolfController.h" />
    <ClInclude Include="Source\WolfManager.h" />
    <ClInclude Include="Source\WolfMovementParameter.h" />
    <ClInclude Include="Source\WolfTeamGrowth.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Source\Enemy.cpp" />
    <ClCompile Include="Source\EnemyController.cpp" />
    <ClCompile Include="Source\EnemyManager.cpp" />
    <ClCompile Include="Source\GameMain.cpp" />
    <ClCompile Include="Source\MeleeDamage.cpp" />
    <ClCompile Include="Source\Stage.cpp" />
    <ClCompile Include="Source\Wolf.cpp" />
    <ClCompile Include="Source\WolfController.cpp" />
    <ClCompile Include="Source\WolfManager.cpp" />
    <ClCompile Include="Source\Windows\Main.cpp" />
  </ItemGroup>
  <!-- FANG_FILES_END -->

  <!-- アセットは exe の隣へ置く。Core\Windows\AssetPath.cpp が exe のディレクトリから引くため。
       15MB の .bin を毎回コピーしないよう SkipUnchangedFiles を立てる -->
  <ItemGroup>
    <FangAssetFile Include="$(MSBuildProjectDirectory)\Assets\Models\**\*" />
    <FangTerrainAssetFile Include="$(MSBuildProjectDirectory)\Assets\Terrain\**\*" />
    <!-- Release は Editor も imgui もリンクしないので、フォントを配布物に入れる理由が無い -->
    <FangFontAssetFile Include="$(MSBuildProjectDirectory)\Assets\Fonts\**\*" Condition="'$(FangConfigurationBase)' != 'Release'" />
  </ItemGroup>
  <Target Name="FangCopyAssets" AfterTargets="Build"
          Inputs="@(FangAssetFile);@(FangTerrainAssetFile);@(FangFontAssetFile)"
          Outputs="@(FangAssetFile -> '$(OutDir)Assets\Models\%(RecursiveDir)%(Filename)%(Extension)');@(FangTerrainAssetFile -> '$(OutDir)Assets\Terrain\%(RecursiveDir)%(Filename)%(Extension)');@(FangFontAssetFile -> '$(OutDir)Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(FangAssetFile)"
          DestinationFiles="@(FangAssetFile -> '$(OutDir)Assets\Models\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FangTerrainAssetFile)"
          DestinationFiles="@(FangTerrainAssetFile -> '$(OutDir)Assets\Terrain\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FangFontAssetFile)"
          DestinationFiles="@(FangFontAssetFile -> '$(OutDir)Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
